#!/bin/sh
# Headless PNG snapshot of STEP/STL/mesh/result files: render-png in.step out.png [--views iso,front,top,right] [--edges] [--scalars NAME]
T="$(cd "$(dirname "$0")/.." && pwd)"; S="${MU_STATE:-$(cd "$T/../.." && pwd)/state}"; mkdir -p "$S/home"
exec "$T/env/bin/python" "$T/recipe/src/mu/post/render_png.py" "$@"
