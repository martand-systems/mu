#!/bin/sh
# OpenFOAM v2606 (gerlero OpenFOAM.app). Mounts its read-only image at /Volumes/OpenFOAM-v2606 while in use. openfoam [-c 'cmds']
T="$(cd "$(dirname "$0")/.." && pwd)"; S="${MU_STATE:-$(cd "$T/../.." && pwd)/state}"; mkdir -p "$S/home"
export HOME="$S/home"; exec "$T/apps/OpenFOAM-v2606.app/Contents/Resources/etc/openfoam" "$@"
