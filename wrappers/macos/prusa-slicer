#!/bin/sh
# PrusaSlicer 2.9.7. CLI: prusa-slicer --export-gcode --load profile.ini part.stl -o part.gcode
T="$(cd "$(dirname "$0")/.." && pwd)"; S="${MU_STATE:-$(cd "$T/../.." && pwd)/state}"; mkdir -p "$S/home"
mkdir -p "$S/prusaslicer"; HOME="$S/home" exec "$T/apps/PrusaSlicer-2.9.7.app/Contents/MacOS/PrusaSlicer" --datadir "$S/prusaslicer" "$@"
