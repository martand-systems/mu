#!/bin/sh
# OpenFOAM v2606 (ESI .debs, unpacked into μ's store). openfoam [-c 'cmds'] runs the commands in an OpenFOAM shell.
T="$(cd "$(dirname "$0")/.." && pwd)"; S="${MU_STATE:-$(cd "$T/../.." && pwd)/state}"; mkdir -p "$S/home"
export HOME="$S/home"
# Open MPI: single-host transports; containers block the CMA single-copy path; allow root only where it is the norm
export OMPI_MCA_btl="${OMPI_MCA_btl:-self,vader}"
[ -f /.dockerenv ] && export OMPI_MCA_btl_vader_single_copy_mechanism=none
[ "$(id -u)" = 0 ] && export OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
exec "$T/apps/openfoam2606/etc/openfoam" "$@"
