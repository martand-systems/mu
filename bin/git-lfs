#!/bin/bash
# git-lfs from the default μ toolchain, so plain `git` (any shell) can use LFS. Installed into $MU_HOME/bin.
case "$(uname -s)" in Darwin) MU_HOME="${MU_HOME:-$HOME/Library/Mu}" ;; *) MU_HOME="${MU_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/mu}" ;; esac
exec "$MU_HOME/toolchains/$(cat "$MU_HOME/default")/env/bin/git-lfs" "$@"
