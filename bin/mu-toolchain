#!/bin/bash
# Commands for one installed toolchain. Reached through the `mu` dispatcher.
set -euo pipefail
MU_TOOLCHAIN="$(cd "$(dirname "$0")/../.." && pwd)"
. "$MU_TOOLCHAIN/recipe/lib/mu-env.sh"
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  version)  if [ "${1:-}" = "--json" ]; then cat "$MU_TOOLCHAIN/MANIFEST.json"; else python - "$MU_TOOLCHAIN/MANIFEST.json" <<'PYV'
import json, sys
m = json.load(open(sys.argv[1]))
print(f"μ {m['version']}  (recipe {m['recipe_commit'][:10]}, {m['platform']}, installed {m['installed']})")
if m.get("layers"):
    print("layers: " + "  ".join(m["layers"]))
PYV
            fi ;;
  path)     echo "$MU_TOOLCHAIN" ;;
  env)      printf 'export MU_TOOLCHAIN=%q\n. %q\n' "$MU_TOOLCHAIN" "$MU_TOOLCHAIN/recipe/lib/mu-env.sh" ;;
  run)      [ $# -gt 0 ] || { echo "usage: mu run <command> [args...]" >&2; exit 2; }; exec "$@" ;;
  shell)    echo "μ $(basename "$MU_TOOLCHAIN") shell. Type exit to leave." >&2; exec "${SHELL:-/bin/zsh}" -i ;;
  python)   exec python "$@" ;;
  doctor)   exec python -m mu.doctor "$@" ;;
  link)     # connect the current project to this toolchain for Claude Code (machine-local links, gitignored)
            P="${MU_PROJECT:-$PWD}"
            [ -f "$P/mu.toml" ] || { echo "mu link: no mu.toml in $P" >&2; exit 2; }
            mkdir -p "$P/.mu" "$P/.claude/skills"
            ln -sfn "$MU_TOOLCHAIN/recipe" "$P/.mu/toolchain"
            for s in "$MU_TOOLCHAIN/recipe/claude-plugin/skills/"*/; do
              n="$(basename "$s")"; ln -sfn "../../.mu/toolchain/claude-plugin/skills/$n" "$P/.claude/skills/$n"
            done
            touch "$MU_HOME/projects.txt"; grep -qxF "$P" "$MU_HOME/projects.txt" || echo "$P" >> "$MU_HOME/projects.txt"
            echo "linked $P → μ $(basename "$MU_TOOLCHAIN"): .mu/toolchain, .claude/skills/{$(ls "$MU_TOOLCHAIN/recipe/claude-plugin/skills" | paste -sd, -)}" ;;
  test)     exec python -m mu.bench "$@" ;;
  help|-h|--help)
    cat <<'H'
  mu run <cmd> [args]    run a command with this toolchain (python, gmsh, ccx, cad, render-png, openfoam, pvbatch,
                         vsp, vspaero, prusa-slicer, cam-python, freecad, paraview, ...)
  mu python [args]       the toolchain's Python (build123d, CadQuery, gmsh, PyVista, openvsp, mu.fea)
  mu shell               interactive shell with the toolchain active
  mu env                 shell code to activate it in the current shell:  eval "$(mu env)"
  mu doctor [--json]     check that every tool starts and reports its pinned version
  mu test [names] [-v]   run the benchmark suite (known-answer + regression checks, in parallel)
  mu link                connect this project (mu.toml) for Claude Code: .mu/toolchain and .claude/skills
  mu version [--json]    toolchain version, recipe commit, layers
  mu path                toolchain folder
H
    ;;
  *) echo "mu: unknown command '$cmd' (see mu help)" >&2; exit 2 ;;
esac
