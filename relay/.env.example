# What goes into Dokploy's Environment tab for the relay service. Placeholders only: generate the real values with
#   relay/gen-credentials.sh init
#   relay/gen-credentials.sh add-client compute office-pc 7001
#   relay/gen-credentials.sh add-client workstation avi-mac 7001
# and paste the output of `relay/gen-credentials.sh env`. Never commit the real file.

# The relay's private key. Clients pin its fingerprint (`relay/gen-credentials.sh fingerprint`).
RELAY_KEY=ck-REPLACE_WITH_GENERATED_KEY

# Clients, comma-separated: <role>:<name>:<password>:<port>[+<port>...]
#   compute      one reverse tunnel on the relay's loopback port (7001-7999), one port per compute node
#   workstation  may connect to the listed compute ports
RELAY_CLIENTS=compute:office-pc:REPLACE_WITH_GENERATED_PASSWORD:7001,workstation:avi-mac:REPLACE_WITH_GENERATED_PASSWORD:7001

# Optional. The server's keepalive ping interval (default 25s).
# RELAY_KEEPALIVE=25s
